# Public HTTPS address of this NEW application; local development uses localhost.
APP_URL=http://127.0.0.1:3048
APP_RUNTIME=vps
PORT=3048
# Explicit local access without Telegram; forbidden with NODE_ENV=production.
DEV_AUTH_ENABLED=false
DEV_USER_ID=1000000001
BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
MEDIA_SIGNING_SECRET=
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal-3-6-pro-preview
# No assumed tariff; enter a verified dated rate to enable estimates.
ASSEMBLYAI_USD_PER_HOUR=
ASSEMBLYAI_PRICING_DATE=
LLM_PROVIDER=openai
# Choose and verify a model using the new OpenAI key before production.
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_CACHED_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_CACHE_WRITE_USD_PER_MILLION=
OPENAI_CACHE_WRITE_12H_USD_PER_MILLION=
OPENAI_PRICING_DATE=
DATA_DIR=.local/data
SQLITE_PATH=.local/data/editor.sqlite
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FONT_PATH=
VAD_MODEL_PATH=
MAX_UPLOAD_BYTES=524288000
MAX_DURATION_SECONDS=900
MAX_OWNER_STORAGE_BYTES=10737418240
# Zero means no automatic deletion of originals/results.
FILE_RETENTION_DAYS=0
