BLOB_READ_WRITE_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal-3-6-pro-preview
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
