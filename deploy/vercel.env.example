# DESIGN TEMPLATE ONLY. Requires the Vercel adapters described in VERCEL.md.
# Not a runtime switch for the current VPS implementation.
APP_RUNTIME=vercel
APP_URL=https://editor.example.com
DEV_AUTH_ENABLED=false
BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
MEDIA_SIGNING_SECRET=
DATABASE_URL=
BLOB_STORE_ID=
